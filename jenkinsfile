pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/navyaarun/calculator-app'
            }
        }    

        stage('Install Dependencies') {
            steps {
                sh 'python -m pip install -r requirements.txt'
            }
        }  

        stage('Run Tests') {
            steps {
                sh 'pytest testcalculator.py'
            }
        }
    }    

    post {
        success {
            mail(
                subject: 'All stages completed successfully.',
                body: 'The build was successful',
                to: "test@example.com"
            )
        }
        failure {
            mail(
                subject: 'Build failed.',
                body: 'The build has failed. Please check the Jenkins console output for details.',
                to: "test@example.com"
            )
        }
    }       
}